<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>sign-up</title>
    <link rel="stylesheet" href="/css/home/signup.css" type="text/css">
    <script src="/js/home/signup.js" defer></script>
</head>
<body>
<div class="background">
    <div class="signup-container">
        <h2 class="signup-title">회원가입</h2>

        <div class="input-group">
            <label for="userId">아이디</label>
            <input type="text" id="userId" class="signup-input" placeholder="아이디를 입력하세요">
        </div>

        <div class="input-group">
            <label for="userPassword">비밀번호</label>
            <input type="password" id="userPassword" class="signup-input" placeholder="비밀번호를 입력하세요">
        </div>

        <div class="input-group">
            <label for="userPasswordCheck">비밀번호 확인</label>
            <input type="password" id="userPasswordCheck" class="signup-input" placeholder="비밀번호를 다시 입력하세요">
        </div>

        <div class="input-group">
            <label for="userNickname">닉네임</label>
            <input type="text" id="userNickname" class="signup-input" placeholder="닉네임을 입력하세요">
        </div>

        <button id="registerBtn" class="signup-btn">회원가입</button>
        <button onclick="window.history.back();" class="back-btn">돌아가기</button>
    </div>
</div>
</body>
</html>