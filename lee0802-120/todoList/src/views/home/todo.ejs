<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>Todo List</title>
    <link rel="stylesheet" href="/css/home/todo.css" type="text/css">
    <script src="/js/home/todo.js" defer></script>
</head>
<body>
    <div class="background">
        <div class="todo-container">
            <h2>To Do List</h2>
            <div class="todo-input-row">
                <input type="text" class="todo-input" id="todo-input">
                <button class="add-btn" id="plus-btn">
                    <img src="/img/plus.svg" alt="버튼">
                </button>
            </div>
            <ul class="todo-list" id="list-add">
            </ul>
        </div>
    </div>
</body>
</html>